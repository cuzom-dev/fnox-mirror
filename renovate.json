{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cuzom-dev/dev-tools"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The fnox version this repository republishes",
      "managerFilePatterns": ["/^fnox-version\\.txt$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "jdx/fnox",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "A new fnox is a new package version: a fix, so release-please releases it",
      "matchDepNames": ["jdx/fnox"],
      "semanticCommitType": "fix",
      "minimumReleaseAge": "3 days"
    }
  ]
}
